def bg(slide):
    f = slide.background.fill
    f.solid()
    f.fore_color.rgb = BG

def textbox(slide, x, y, w, h, text, size=16, color=WHITE, bold=False,
            align=PP_ALIGN.LEFT, valign=MSO_ANCHOR.TOP, font="Aptos",
            margin=0.04):
    sh = slide.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
    tf = sh.text_frame
    tf.clear()
    tf.word_wrap = True
    tf.margin_left = Inches(margin)
    tf.margin_right = Inches(margin)
    tf.margin_top = Inches(margin)
    tf.margin_bottom = Inches(margin)
    tf.vertical_anchor = valign
    p = tf.paragraphs[0]
    p.alignment = align
    r = p.add_run()
    r.text = text
    r.font.name = font
    r.font.size = Pt(size)
    r.font.bold = bold
    r.font.color.rgb = color
    return sh

def card(slide, x, y, w, h, fill=PANEL, line=LINE):
    sh = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(x), Inches(y), Inches(w), Inches(h))
    sh.fill.solid()
    sh.fill.fore_color.rgb = fill
    sh.line.color.rgb = line
    sh.line.width = Pt(1)
    return sh

def header(slide, section, title, sub):
    textbox(slide, .65, .32, 12, .25, section.upper(), 10, CYAN, True)
    textbox(slide, .65, .70, 12, .55, title, 27, WHITE, True)
    textbox(slide, .68, 1.31, 12, .38, sub, 12, MUTED)

def footer(slide, n):
    textbox(slide, .68, 7.15, 10, .16, "SCAMSHIELD INDIA  •  EXPLAINABLE SCAM & PHISHING DETECTION", 8, MUTED, True)
    textbox(slide, 12.05, 7.11, .55, .2, f"{n:02d}/04", 9, CYAN, True, PP_ALIGN.RIGHT)

def add_bullets(slide, x, y, w, h, items, size=13, color=WHITE, gap=7):
    sh = slide.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
    tf = sh.text_frame
    tf.clear()
    tf.word_wrap = True
    tf.margin_left = Inches(.05)
    tf.margin_right = Inches(.05)
    tf.margin_top = Inches(.03)
    for i, item in enumerate(items):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.text = "• " + item
        p.font.name = "Aptos"
        p.font.size = Pt(size)
        p.font.color.rgb = color
        p.space_after = Pt(gap)
    return sh

def arrow(slide, x1, y1, x2, y2, color=CYAN):
    c = slide.shapes.add_connector(MSO_CONNECTOR.STRAIGHT, Inches(x1), Inches(y1), Inches(x2), Inches(y2))
    c.line.color.rgb = color
    c.line.width = Pt(2)
    c.line.end_arrowhead = True
    return c

